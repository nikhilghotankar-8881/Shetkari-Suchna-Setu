# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database Configuration (PostgreSQL / SQLite for local development)
DATABASE_URL=sqlite+aiosqlite:///./shetkari.db
# For production (PostgreSQL/Supabase):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/shetkari_suchna_setu

# Admin Authentication & JWT Security
SECRET_KEY=change-this-to-a-very-secure-256-bit-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
ALGORITHM=HS256

# Administrative Initial Credentials (for bootstrapping local test)
ADMIN_BOOTSTRAP_EMAIL=admin@shetkari-setu.gov.in
ADMIN_BOOTSTRAP_PASSWORD=Admin@SecurePassword123

# External AI Provider (Optional / for LLM extraction)
# Public notice text only; no farmer PII is ever sent externally
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
